[Unit]
Description=Freelancer Agency Autonomous Daemon
After=network.target

[Service]
Type=simple
User=sups
WorkingDirectory=/home/sups/Documents/Code/freelancer_agency/temp/sandbox/server-setup
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/home/sups/Documents/Code/freelancer_agency/temp/sandbox/server-setup/.env.local
ExecStart=/usr/bin/python3 /home/sups/Documents/Code/freelancer_agency/temp/sandbox/server-setup/run_agency.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
