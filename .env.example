# Telegram Bot Configuration
# Obtain bot token from @BotFather and chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Freelancer.com API (Optional for public discovery, required for authenticated endpoints)
FREELANCER_API_TOKEN=your_freelancer_api_token_here

# Storage & Database
DB_PATH=data/agency.db

# Daemon Polling Intervals (in seconds)
SCAN_INTERVAL_SECONDS=300
WATCHER_INTERVAL_SECONDS=3600
OCI_HEARTBEAT_INTERVAL_SECONDS=1800

# Logging
LOG_LEVEL=INFO

# ==============================================================================
# Google AI Studio / Gemini API Configuration
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_MODEL=gemini-2.5-pro
GEMINI_PRO_MODEL=gemini-2.5-pro

